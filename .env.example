APP_NAME=MadeForU
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://madeforu.co.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Hostinger → Databases → MySQL: create a database and user, paste them here
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u000000000_store
DB_USERNAME=u000000000_store
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger email (Emails → your mailbox → Connect apps) — order confirmations go out through this
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=orders@madeforu.co.in
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@madeforu.co.in
MAIL_FROM_NAME="${APP_NAME}"

# Store
STORE_NAME=MadeForU
STORE_TAGLINE="Made for your moments"
STORE_EMAIL=support@madeforu.co.in
STORE_PHONE=
# WhatsApp number with country code, digits only: 919876543210
STORE_WHATSAPP=
# Blank = MadeForU's details (phone +91 93810 24794, Korremula address). Also editable in Admin → Settings → Store details.
STORE_ADDRESS=
STORE_CITY=Hyderabad
STORE_REGION=Telangana
STORE_POSTCODE=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_PINTEREST=

FREE_SHIPPING_OVER=499
SHIPPING_FEE=60
COD_ENABLED=true
COD_FEE=50
COD_MAX=5000
UPLOAD_MAX_KB=15360

# Payment gateways. These can also be entered in Admin → Settings → Payment gateways (those win).
# Pre-selected online gateway when both are on: razorpay | cashfree
PAYMENT_DEFAULT=razorpay

# Razorpay → Settings → API Keys. Webhook: https://madeforu.co.in/webhooks/razorpay (events: payment.captured, order.paid)
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree → Developers → API Keys. Webhook: https://madeforu.co.in/webhooks/cashfree (Payment success)
CASHFREE_ENABLED=true
CASHFREE_MODE=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Analytics & search engines — all optional, also editable in Admin → Settings
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_PURCHASE_LABEL=
META_PIXEL_ID=
MS_CLARITY_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
PINTEREST_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=
# 32 hex characters; generate with: php -r "echo bin2hex(random_bytes(16));"
INDEXNOW_KEY=

# The WordPress site the importer copies from (while it is still online)
WOO_URL=https://madeforu.co.in
# Optional: WooCommerce → Settings → Advanced → REST API → Add key (Read). Needed to import draft products.
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Images: DigitalOcean Spaces. Imported images on *.digitaloceanspaces.com are used as they are.
# Set MEDIA_DISK=spaces so new uploads from admin go to the same Space.
# Spaces → Settings → Access keys (or API → Spaces Keys) for KEY/SECRET.
MEDIA_DISK=public
MEDIA_KEEP_HOSTS=digitaloceanspaces.com
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=friendsmedia
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_URL=https://friendsmedia.sgp1.cdn.digitaloceanspaces.com
DO_SPACES_ROOT=store

# Cash on delivery charges: the higher of the fixed amount and the % of the order (e.g. 40 and 2)
COD_FEE_PERCENT=0

# Delhivery (also in Admin → Settings → Delhivery shipping)
DELHIVERY_ENABLED=false
DELHIVERY_AUTO=true
DELHIVERY_MODE=production
DELHIVERY_TOKEN=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_PICKUP_PINCODE=
DELHIVERY_SHIPPING_MODE=Surface
DELHIVERY_DEFAULT_WEIGHT=300
DELHIVERY_CHECK_PINCODES=true

# Tax invoice (also in Admin → Settings → Invoice). Prices include GST.
INVOICE_PREFIX=MFU
INVOICE_LEGAL_NAME="MadeForU"
INVOICE_GSTIN=
INVOICE_ADDRESS="Hyderabad, Telangana, India"
INVOICE_STATE=Telangana
INVOICE_GST_RATE=18
INVOICE_HSN=

# WhatsApp Business Cloud API (also in Admin → Settings → WhatsApp messages). Templates: see README.
WHATSAPP_API_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_ADMIN_NUMBERS=

# Stock & abandoned carts (also in Admin → Settings)
LOW_STOCK_THRESHOLD=3
ABANDONED_CART_REMINDERS=true
ABANDONED_FIRST_HOURS=1
ABANDONED_SECOND_HOURS=24
ABANDONED_COUPON=
WHATSAPP_TEMPLATE_CART=cart_reminder

# Reviews
REVIEW_REQUESTS=true
REVIEW_REQUEST_DAYS=2
REVIEWS_AUTO_APPROVE=false
WHATSAPP_TEMPLATE_REVIEW=

# Email notifications (switch each one on/off in Admin → Settings → Email notifications)
NOTIFY_ADMIN_EMAILS=
NOTIFY_DAILY_SUMMARY=true
NOTIFY_DAILY_SUMMARY_TIME=21:00
