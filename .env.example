APP_NAME=MadeForU
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://madeforu.co.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Hostinger → Databases → MySQL: create a database and user, paste them here
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u000000000_store
DB_USERNAME=u000000000_store
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger email (Emails → your mailbox → Connect apps) — order confirmations go out through this
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=orders@madeforu.co.in
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@madeforu.co.in
MAIL_FROM_NAME="${APP_NAME}"

# Store
STORE_NAME=MadeForU
STORE_TAGLINE="Made for your moments"
STORE_EMAIL=hello@madeforu.co.in
STORE_PHONE=
# WhatsApp number with country code, digits only: 919876543210
STORE_WHATSAPP=
STORE_ADDRESS="Hyderabad, Telangana, India"
STORE_CITY=Hyderabad
STORE_REGION=Telangana
STORE_POSTCODE=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_PINTEREST=

FREE_SHIPPING_OVER=499
SHIPPING_FEE=60
COD_ENABLED=true
COD_FEE=50
COD_MAX=5000
UPLOAD_MAX_KB=15360

# Razorpay → Settings → API Keys. Webhook: https://madeforu.co.in/webhooks/razorpay (events: payment.captured, order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Analytics & search engines — all optional, also editable in Admin → Settings
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_PURCHASE_LABEL=
META_PIXEL_ID=
MS_CLARITY_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
PINTEREST_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=
# 32 hex characters; generate with: php -r "echo bin2hex(random_bytes(16));"
INDEXNOW_KEY=

# The WordPress site the importer copies from (while it is still online)
WOO_URL=https://madeforu.co.in
